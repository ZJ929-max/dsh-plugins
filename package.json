{
  "name": "dsh-plugins",
  "version": "0.2.0",
  "description": "Meta bundle for the independent DSH plugins maintained by ZJ929-max: one install, latest main of each plugin; no runtime code.",
  "license": "MPL-2.0",
  "author": "ZJ929-max",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZJ929-max/dsh-plugins.git"
  },
  "homepage": "https://github.com/ZJ929-max/dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/ZJ929-max/dsh-plugins/issues"
  },
  "files": [
    "patches",
    "index.json",
    "LICENSE",
    "README.md",
    "AI-DISCLOSURE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./patches/20-bili-peek.yml",
        "./patches/30-view-image.yml",
        "./patches/40-agent-bus.yml",
        "./patches/50-tokeneconomizer.yml",
        "./patches/55-approval-reason-relay.yml",
        "./patches/60-aegis.yml"
      ]
    }
  },
  "dependencies": {
    "dsh-bili-peek": "github:ZJ929-max/dsh-bili-peek",
    "dsh-view-image": "github:ZJ929-max/dsh-view-image",
    "dsh-tokeneconomizer": "github:ZJ929-max/tokeneconomizer-dsh",
    "dsh-agent-bus": "github:ZJ929-max/dsh-agent-bus",
    "dsh-approval-reason-relay": "github:ZJ929-max/dsh-approval-reason-relay",
    "dsh-aegis": "github:ZJ929-max/dsh-aegis"
  },
  "engines": {
    "node": ">=22"
  }
}
