{
  "name": "dsh-plugins",
  "version": "0.1.0",
  "description": "Meta bundle for the independent DSH plugins maintained by ZJ929-max: installs dsh-tool-fold, dsh-bili-peek, dsh-view-image and @local/agent-bus in one step. Contains no runtime code.",
  "license": "MPL-2.0",
  "author": "ZJ929-max",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZJ929-max/dsh-plugins.git"
  },
  "homepage": "https://github.com/ZJ929-max/dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/ZJ929-max/dsh-plugins/issues"
  },
  "files": [
    "patches",
    "index.json",
    "LICENSE",
    "README.md",
    "AI-DISCLOSURE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./patches/10-tool-fold.yml",
        "./patches/20-bili-peek.yml",
        "./patches/30-view-image.yml",
        "./patches/40-agent-bus.yml"
      ]
    }
  },
  "dependencies": {
    "dsh-tool-fold": "github:ZJ929-max/dsh-tool-fold#cd2e0290da5b9bad5936812ee87778c60d565767",
    "dsh-bili-peek": "github:ZJ929-max/dsh-bili-peek#7f3850eae70129f71872d9c38da691b1e5919eda",
    "dsh-view-image": "github:ZJ929-max/dsh-view-image#5d220e6ca4a83a73c251887eb511a86c0360a4db",
    "@local/agent-bus": "github:ZJ929-max/dsh-agent-bus#3a46f1f33c78dc8782912b565efc127e8ca328b1"
  },
  "engines": {
    "node": ">=22"
  }
}
